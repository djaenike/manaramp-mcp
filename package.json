{
  "name": "manaramp-mcp",
  "version": "1.0.0",
  "type": "module",
  "main": "./dist/local/index.js",
  "exports": {
    ".": { "types": "./dist/tools/index.d.ts", "default": "./dist/tools/index.js" },
    "./local": { "types": "./dist/local/index.d.ts", "default": "./dist/local/index.js" }
  },
  "scripts": {
    "build": "tsup",
    "prepare": "npm run build",
    "dev": "tsx src/local/index.ts",
    "start": "node dist/local/index.js",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^22.20.0",
    "mongodb": "^7.6.0",
    "tsup": "^8.5.1",
    "tsx": "^4.23.13",
    "typescript": "^5.9.3"
  }
}
